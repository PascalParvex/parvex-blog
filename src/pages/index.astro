---
const pageTitle = "Links";
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
      h1 { font-size: 2rem; margin-bottom: 1.5rem; color: #333; }
      .link-list { list-style: none; padding: 0; }
      .link-list li { margin-bottom: 1rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
      .link-list a { 
        display: block; 
        font-size: 1.5rem; 
        font-weight: bold; 
        color: #0563c1; 
        text-decoration: none; 
      }
      .link-list a:hover { text-decoration: underline; color: #004499; }
      .description { font-size: 0.9rem; color: #666; margin-top: 0.2rem; }
    </style>
  </head>
  <body>
    <h1>Links</h1>
    <ul class="link-list">
      <li>
        <a href="https://e.pcloud.link/publink/show?code=kZQvNGZzwm1LqklajRGS35oze7PCf1OQQok" target="_blank" rel="noopener">
          Tokio Hotel Videos
        </a>
        <div class="description">Exklusive Videosammlung</div>
      </li>
      <li>
        <a href="https://e.pcloud.link/publink/show?code=kZvvNGZ8xFiRj6HRy4CnhOT3nDRzRllC5GX" target="_blank" rel="noopener">
          Tokio Hotel Scans
        </a>
        <div class="description">Bildmaterial und Scans</div>
      </li>
      <li>
        <a href="https://youtube.com/@parvex" target="_blank" rel="noopener">
          YouTube (8K-AI-Upscales and more)
        </a>
        <div class="description">Der offizielle Kanal von Pascal Parvex</div>
      </li>
      <li>
        <a href="https://www.tiktok.com/@pascalparvex" target="_blank" rel="noopener">
          TikTok
        </a>
        <div class="description">Kurzvideos von Pascal Parvex</div>
      </li>
    </ul>
  </body>
</html>   